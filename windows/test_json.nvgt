void main() {
	json_object@ j = json_object();
	j.set("test", "value");
	
	// Check exists
	print("exists test: " + j.exists("test"));
	print("exists missing: " + j.exists("missing"));
	
	// Get as number
	j.set("num", 42);
	double n = double(j["num"]);
	print("num: " + n);
	
	// Get as bool
	j.set("flag", true);
	bool b = bool(j["flag"]);
	print("flag: " + b);
}