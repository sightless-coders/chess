// accounts.nvgt - Account system for Chess (NVGT version)
// Handles user registration, login, and statistics tracking.
// Uses local file storage for accounts and stats.

#include "input_forms.nvgt"
#include "dget.nvgt"
#include "settings.nvgt"

const string ACCOUNTS_FILE = "accounts.json";
const string SESSION_FILE = "session.json";

// Convert uint to hex string
string to_hex(uint value) {
	const string hex_chars = "0123456789abcdef";
	string result = "";
	for (int i = 7; i >= 0; i--) {
		uint nibble = (value >> (i * 4)) & 0xF;
		result += hex_chars[nibble];
	}
	return result;
}

class AccountManager {
	bool initialized = false;

	AccountManager() {
		init();
	}

	void init() {
		if (initialized) return;
		initialized = true;
	}

	// Hash a password using simple method (in production, use proper crypto)
	string hash_password(const string&in password, const string&in salt = "") {
		string combined = password + salt + "chess_salt_2024";
		uint hash = 0;
		for (uint i = 0; i < combined.length(); i++) {
			hash = hash * 31 + character_to_ascii(combined[i]);
		}
		return to_hex(hash);
	}

	string generate_salt() {
		string salt = "";
		for (int i = 0; i < 16; i++) {
			salt += string(random(97, 122)); // 'a' to 'z' as char code
		}
		return salt;
	}

	// Register a new account
	bool register_account(const string&in username, const string&in password, string&out error) {
		if (username.empty() || password.empty()) {
			error = "Username and password cannot be empty";
			return false;
		}
		if (username.length() < 3) {
			error = "Username must be at least 3 characters";
			return false;
		}
		if (password.length() < 6) {
			error = "Password must be at least 6 characters";
			return false;
		}

		// Check if username exists
		if (account_exists(username)) {
			error = "Username already exists";
			return false;
		}

		string salt = generate_salt();
		string password_hash = hash_password(password, salt);

		// Save account
		json_object@ account = json_object();
		account.set("username", username);
		account.set("salt", salt);
		account.set("password_hash", password_hash);
		account.set("created_at", int(ticks()));
		account.set("wins", 0);
		account.set("losses", 0);
		account.set("draws", 0);

		json_object@ accounts = load_accounts();
		accounts.set(username, account);
		save_accounts(accounts);

		// Auto-login
		save_session(username);
		return true;
	}

	// Login with username and password
	bool login(const string&in username, const string&in password, string&out error) {
		if (username.empty() || password.empty()) {
			error = "Username and password cannot be empty";
			return false;
		}

		json_object@ accounts = load_accounts();
		if (!accounts.exists(username)) {
			error = "Account not found";
			return false;
		}

		json_object@ account = json_object(accounts[username]);
		string salt = string(account["salt"]);
		string stored_hash = string(account["password_hash"]);
		string test_hash = hash_password(password, salt);

		if (test_hash != stored_hash) {
			error = "Incorrect password";
			return false;
		}

		save_session(username);
		return true;
	}

	// Guest login (anonymous)
	bool login_guest(string&out username) {
		string guest_name = "Guest_" + random(1000, 9999);
		username = guest_name;
		save_session(username);
		return true;
	}

	// Check if user is logged in
	bool is_logged_in(string&out username) {
		json_object@ session = load_session();
		if (@session == null) return false;
		username = string(session["username"]);
		return !username.empty();
	}

	// Logout
	void logout() {
		if (file_exists(SESSION_FILE)) file_delete(SESSION_FILE);
	}

	// Get user stats
	void get_stats(const string&in username, int&out wins, int&out losses, int&out draws) {
		json_object@ accounts = load_accounts();
		if (!accounts.exists(username)) {
			wins = losses = draws = 0;
			return;
		}
		json_object@ account = json_object(accounts[username]);
		wins = int(double(account["wins"]));
		losses = int(double(account["losses"]));
		draws = int(double(account["draws"]));
	}

	// Record game result
	void record_result(const string&in username, const string&in result) { // "win", "loss", "draw"
		json_object@ accounts = load_accounts();
		if (!accounts.exists(username)) return;

		json_object@ account = json_object(accounts[username]);
		if (result == "win") account.set("wins", int(double(account["wins"])) + 1);
		else if (result == "loss") account.set("losses", int(double(account["losses"])) + 1);
		else if (result == "draw") account.set("draws", int(double(account["draws"])) + 1);

		accounts.set(username, account);
		save_accounts(accounts);
	}

	// Get formatted stats string
	string get_stats_string(const string&in username) {
		int wins, losses, draws;
		get_stats(username, wins, losses, draws);
		int total = wins + losses + draws;
		double rate = total > 0 ? (wins * 100.0 / total) : 0.0;
		// Format rate to 1 decimal place manually
		int rate_int = int(rate * 10);
		int whole = rate_int / 10;
		int decimal = rate_int % 10;
		string rate_str = "" + whole + "." + decimal;
		return username + ": " + wins + "W-" + losses + "L-" + draws + "D (" + rate_str + "% win rate)";
	}

	// Private helpers
	bool account_exists(const string&in username) {
		json_object@ accounts = load_accounts();
		return accounts.exists(username);
	}

	json_object@ load_accounts() {
		json_object@ accounts = json_object();
		if (!file_exists(ACCOUNTS_FILE)) return accounts;

		file f;
		f.open(ACCOUNTS_FILE, "rb");
		string content = f.read();
		f.close();
		if (!content.empty()) {
			@accounts = parse_json(content);
		}
		return accounts;
	}

	void save_accounts(json_object@ accounts) {
		file f;
		f.open(ACCOUNTS_FILE, "wb");
		f.write(accounts.stringify());
		f.close();
	}

	void save_session(const string&in username) {
		json_object@ session = json_object();
		session.set("username", username);
		session.set("logged_in_at", int(ticks()));
		file f;
		f.open(SESSION_FILE, "wb");
		f.write(session.stringify());
		f.close();
	}

	json_object@ load_session() {
		if (!file_exists(SESSION_FILE)) return null;
		file f;
		f.open(SESSION_FILE, "rb");
		string content = f.read();
		f.close();
		if (content.empty()) return null;
		return parse_json(content);
	}
}

// UI functions for account management
void show_login_menu(AccountManager@ auth, string&out logged_in_user) {
	menu m;
	m.focus_first_item = true;
	m.sounds_prefix = "sounds/";
	m.click_sound = "ui/click.wav";
	m.select_sound = "ui/move.wav";
	m.edge_sound = "ui/error.wav";
	m.intro_text = "Account Menu. Use up/down arrows to navigate, Enter to select.";
	m.add_item("Sign In", "login");
	m.add_item("Create Account", "register");
	m.add_item("Play as Guest", "guest");
	m.add_item("Back", "back");

	while (true) {
		wait(5);
		if (m.monitor()) continue;
		if (m.selected_item < 0) return;

		string id = m.get_selected_item_id();
		if (id == "back") return;

		if (id == "login") {
			input_form f("Sign In");
			f.add_text_field("username", "Username", "", true);
			f.add_text_field("password", "Password", "", true, true);
			dictionary@ d = f.run();
			if (@d != null && !f.user_canceled) {
				string username, password;
				d.get("username", username);
				d.get("password", password);
				string error;
				if (auth.login(username, password, error)) {
					logged_in_user = username;
					speak("Welcome back, " + username + "!", true);
					return;
				} else {
					speak("Login failed: " + error, true);
				}
			}
		} else if (id == "register") {
			input_form f("Create Account");
			f.add_text_field("username", "Username", "", true);
			f.add_text_field("password", "Password", "", true, true);
			f.add_text_field("confirm", "Confirm Password", "", true, true);
			dictionary@ d = f.run();
			if (@d != null && !f.user_canceled) {
				string username, password, confirm;
				d.get("username", username);
				d.get("password", password);
				d.get("confirm", confirm);
				if (password != confirm) {
					speak("Passwords do not match", true);
					continue;
				}
				string error;
				if (auth.register_account(username, password, error)) {
					logged_in_user = username;
					speak("Account created! Welcome, " + username + "!", true);
					return;
				} else {
					speak("Registration failed: " + error, true);
				}
			}
		} else if (id == "guest") {
			string guest_name;
			auth.login_guest(guest_name);
			logged_in_user = guest_name;
			speak("Playing as guest: " + guest_name, true);
			return;
		}
	}
}

void show_account_menu(AccountManager@ auth, const string&in username) {
	menu m;
	m.focus_first_item = true;
	m.sounds_prefix = "sounds/";
	m.click_sound = "ui/click.wav";
	m.select_sound = "ui/move.wav";
	m.edge_sound = "ui/error.wav";
	m.intro_text = "Account: " + username;
	m.add_item("View Statistics", "stats");
	m.add_item("Sign Out", "logout");
	m.add_item("Back", "back");

	while (true) {
		wait(5);
		if (m.monitor()) continue;
		if (m.selected_item < 0) return;

		string id = m.get_selected_item_id();
		if (id == "back") return;

		if (id == "stats") {
			speak(auth.get_stats_string(username), true);
		} else if (id == "logout") {
			auth.logout();
			speak("Signed out", true);
			return;
		}
	}
}