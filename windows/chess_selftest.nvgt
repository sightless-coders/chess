// chess_selftest.nvgt - Verifies the NVGT chess engine against the same known
// counts the Android (Java) version is tested with. The suite is registered
// with nv-test (vendored in ../vendor/nv-test), which prints one line per test,
// writes chess_selftest.log and returns the failure count used as the exit
// code. Exits 0 when everything passes, 1 otherwise. Compiled and run by
// build_windows.bat.

#include "chess_core.nvgt"
#include "../vendor/nv-test/includes/nv_test.nvgt"

nv_tester tester("chess_selftest.log");

int char_piece(string ch) {
	int type = 0;
	if (ch == "k" || ch == "K") type = P_KING;
	else if (ch == "q" || ch == "Q") type = P_QUEEN;
	else if (ch == "r" || ch == "R") type = P_ROOK;
	else if (ch == "b" || ch == "B") type = P_BISHOP;
	else if (ch == "n" || ch == "N") type = P_KNIGHT;
	else if (ch == "p" || ch == "P") type = P_PAWN;
	else return 0;
	if (ch == "K" || ch == "Q" || ch == "R" || ch == "B" || ch == "N" || ch == "P") return type + C_WHITE;
	return type;
}

// Places one FEN rank row (e.g. "r3k2r") on the board.
void setup_row(int row, string pattern) {
	int c = 0;
	for (uint i = 0; i < pattern.length() && c < 8; i++) {
		string ch = pattern.substr(i, 1);
		if (ch == "1") c += 1;
		else if (ch == "2") c += 2;
		else if (ch == "3") c += 3;
		else if (ch == "4") c += 4;
		else if (ch == "5") c += 5;
		else if (ch == "6") c += 6;
		else if (ch == "7") c += 7;
		else if (ch == "8") c += 8;
		else {
			sq[row * 8 + c] = char_piece(ch);
			c++;
		}
	}
}

void clear_for_fen() {
	for (int i = 0; i < 64; i++) sq[i] = 0;
	white_to_move = true;
	castling_rights = 0;
	ep_target = -1;
	halfmove_clock = 0;
}

void setup_kiwipete() {
	clear_for_fen();
	setup_row(0, "r3k2r");
	setup_row(1, "p1ppqpb1");
	setup_row(2, "bn2pnp1");
	setup_row(3, "3PN3");
	setup_row(4, "1p2P3");
	setup_row(5, "2N2Q1p");
	setup_row(6, "PPPBBPPP");
	setup_row(7, "R3K2R");
	castling_rights = CK_WK | CK_WQ | CK_BK | CK_BQ;
}

void setup_en_passant() {
	clear_for_fen();
	setup_row(1, "2p5");
	setup_row(2, "3p4");
	setup_row(3, "KP5r");
	setup_row(4, "1R3p1k");
	setup_row(6, "4P1P1");
}

void setup_scholars_mate() {
	clear_for_fen();
	setup_row(0, "rnb1kbnr");
	setup_row(1, "pppp1ppp");
	setup_row(3, "4p3");
	setup_row(4, "6Pq");
	setup_row(5, "5P2");
	setup_row(6, "PPPPP2P");
	setup_row(7, "RNBQKBNR");
}

void setup_stalemate() {
	clear_for_fen();
	setup_row(0, "7k");
	setup_row(1, "5Q2");
	setup_row(2, "6K1");
	white_to_move = false;
}

void setup_mate_in_one() {
	clear_for_fen();
	setup_row(0, "r1bqkbnr");
	setup_row(1, "pppp1ppp");
	setup_row(2, "2n5");
	setup_row(3, "4p3");
	setup_row(4, "2B1P3");
	setup_row(5, "5Q2");
	setup_row(6, "PPPP1PPP");
	setup_row(7, "RNBQKBNR");
}

// ------------------------------------------------------------- perft -------
bool test_start_depth_1() { board_reset(); return perft(1) == 20; }
bool test_start_depth_2() { board_reset(); return perft(2) == 400; }
bool test_start_depth_3() { board_reset(); return perft(3) == 8902; }
bool test_start_depth_4() { board_reset(); return perft(4) == 197281; }

// Kiwipete exercises castling, pins and checks.
bool test_kiwipete_depth_1() { setup_kiwipete(); return perft(1) == 48; }
bool test_kiwipete_depth_2() { setup_kiwipete(); return perft(2) == 2039; }
bool test_kiwipete_depth_3() { setup_kiwipete(); return perft(3) == 97862; }

bool test_en_passant_depth_1() { setup_en_passant(); return perft(1) == 14; }
bool test_en_passant_depth_2() { setup_en_passant(); return perft(2) == 191; }
bool test_en_passant_depth_3() { setup_en_passant(); return perft(3) == 2812; }

// ---------------------------------------------------------- game state -----
// Black has delivered scholar's mate: White is checkmated.
bool test_checkmate_detected() {
	setup_scholars_mate();
	legal_moves(false);
	return gen_pool.length() == 0 && in_check(true);
}

bool test_stalemate_detected() {
	setup_stalemate();
	legal_moves(false);
	return gen_pool.length() == 0 && !in_check(false);
}

// ---------------------------------------------------------------- AI -------
// The AI must only ever offer a legal move.
bool test_ai_returns_legal_move() {
	board_reset();
	move_t@ m = null;
	try {
		@m = ai_find_move(3, 2000);
	} catch {
		return false;
	}
	if (@m == null) return false;
	legal_moves(false);
	for (uint i = 0; i < gen_pool.length(); i++) {
		if (gen_pool[i].from == m.from && gen_pool[i].to == m.to && gen_pool[i].promo == m.promo) return true;
	}
	return false;
}

// White to move with mate in one on the board.
bool test_ai_finds_mate_in_one() {
	setup_mate_in_one();
	move_t@ finisher = null;
	try {
		@finisher = ai_find_move(3, 3000);
	} catch {
		return false;
	}
	if (@finisher == null) return false;
	print("      mate found: " + move_notation(finisher) + "\n");
	board_make(finisher);
	legal_moves(false);
	bool mates = gen_pool.length() == 0 && in_check(white_to_move);
	board_unmake(finisher);
	return mates;
}

int main() {
	core_init();

	tester.add_test("starting position: perft depth 1", test_start_depth_1, "expected 20 legal moves");
	tester.add_test("starting position: perft depth 2", test_start_depth_2, "expected 400 legal moves");
	tester.add_test("starting position: perft depth 3", test_start_depth_3, "expected 8902 legal moves");
	tester.add_test("starting position: perft depth 4", test_start_depth_4, "expected 197281 legal moves");

	tester.add_test("kiwipete: perft depth 1", test_kiwipete_depth_1, "expected 48 legal moves");
	tester.add_test("kiwipete: perft depth 2", test_kiwipete_depth_2, "expected 2039 legal moves");
	tester.add_test("kiwipete: perft depth 3", test_kiwipete_depth_3, "expected 97862 legal moves");

	tester.add_test("en passant: perft depth 1", test_en_passant_depth_1, "expected 14 legal moves");
	tester.add_test("en passant: perft depth 2", test_en_passant_depth_2, "expected 191 legal moves");
	tester.add_test("en passant: perft depth 3", test_en_passant_depth_3, "expected 2812 legal moves");

	tester.add_test("checkmate detected", test_checkmate_detected, "no legal moves and the side to move is in check");
	tester.add_test("stalemate detected", test_stalemate_detected, "no legal moves and the side to move is not in check");

	tester.add_test("AI returns a legal move", test_ai_returns_legal_move, "the AI's move must exist in the legal move list");
	tester.add_test("AI finds mate in 1", test_ai_finds_mate_in_one, "the AI must choose the mating move");

	int failed = tester.run_tests();
	if (failed == 0) print("ALL TESTS PASSED");
	else print(failed + " TEST(S) FAILED");
	return failed > 0 ? 1 : 0;
}
